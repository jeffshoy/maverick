{
  "id": "ConnectionManager",
  "header": "🔗 Connection Manager",
  "title": "Active Connections:",
  "width": 400,
  "content": [
    {
      "type": "label",
      "text": "Connection List:",
      "bold": true,
      "margin": "0,0,0,5"
    },
    {
      "type": "label",
      "name": "lblConnectionCount",
      "text": "Loading connections...",
      "margin": "0,0,0,10"
    },
    {
      "type": "stackpanel",
      "orientation": "Vertical",
      "margin": "0,5,0,10",
      "children": [
        {
          "type": "label",
          "text": "Filter Options:",
          "bold": true
        },
        {
          "type": "stackpanel",
          "orientation": "Horizontal",
          "children": [
            {
              "type": "label",
              "text": "Show:"
            },
            {
              "type": "combobox",
              "name": "cmbConnectionFilter",
              "width": 120,
              "items": ["All Sessions", "My Sessions Only", "RDP Only", "SSH Only"],
              "selectedIndex": 1
            }
          ]
        }
      ]
    }
  ],
  "buttons": [
    {
      "text": "🔄 Refresh",
      "action": "refreshConnections",
      "width": 80,
      "height": 30,
      "style": "primary"
    },
    {
      "text": "🔍 Status",
      "action": "checkStatus",
      "width": 80,
      "height": 30,
      "style": "success"
    }
  ]
}
{
  "id": "Notifications",
  "header": "🔔 Notifications",
  "title": "System Notifications:",
  "width": 300,
  "content": [
    {
      "type": "label",
      "text": "Recent Activity:",
      "bold": true,
      "margin": "0,0,0,10"
    },
    {
      "type": "textbox",
      "name": "txtNotifications",
      "height": 200,
      "multiline": true,
      "margin": "0,0,0,10",
      "placeholder": "No notifications..."
    },
    {
      "type": "stackpanel",
      "orientation": "Horizontal",
      "margin": "0,5,0,5",
      "children": [
        {
          "type": "label",
          "text": "Filter:",
          "bold": true
        },
        {
          "type": "combobox",
          "name": "cmbFilter",
          "width": 120,
          "items": ["All", "Errors", "Warnings", "Info"],
          "selectedIndex": 0
        }
      ]
    }
  ],
  "buttons": [
    {
      "text": "Clear All",
      "action": "clearNotifications",
      "width": 80,
      "height": 30,
      "style": "warning"
    },
    {
      "text": "Refresh",
      "action": "refreshNotifications",
      "width": 80,
      "height": 30,
      "style": "primary"
    }
  ]
}
{
  "id": "ServicePicker",
  "header": "🔧 AWS Service Configuration",
  "width": 500,
  "height": 600,
  "content": [
    {
      "type": "label",
      "text": "Select AWS services to enable:",
      "fontSize": 14,
      "margin": "0,0,0,10"
    },
    {
      "type": "treeview",
      "name": "tvServices",
      "height": 400,
      "tooltip": "Expand categories and check services to enable"
    },
    {
      "type": "stackpanel",
      "orientation": "horizontal",
      "margin": "0,10,0,0",
      "content": [
        {
          "type": "button",
          "name": "btnSelectAll",
          "text": "Select All",
          "width": 80,
          "action": "selectAllServices"
        },
        {
          "type": "button",
          "name": "btnSelectNone",
          "text": "Select None",
          "width": 80,
          "margin": "10,0,0,0",
          "action": "selectNoServices"
        },
        {
          "type": "button",
          "name": "btnDefaults",
          "text": "Defaults",
          "width": 80,
          "margin": "10,0,0,0",
          "action": "selectDefaultServices"
        }
      ]
    },
    {
      "type": "stackpanel",
      "orientation": "horizontal",
      "margin": "0,20,0,0",
      "content": [
        {
          "type": "button",
          "name": "btnSave",
          "text": "💾 Save Configuration",
          "width": 150,
          "action": "saveServiceConfiguration"
        },
        {
          "type": "button",
          "name": "btnCancel",
          "text": "Cancel",
          "width": 80,
          "margin": "10,0,0,0",
          "action": "closePanel"
        }
      ]
    }
  ]
}
{
  "id": "BugReport",
  "header": "📝 Bug Report",
  "title": "Report Bug:",
  "width": 350,
  "content": [
    {
      "type": "label",
      "text": "Bug Title:",
      "bold": true,
      "margin": "0,0,0,5"
    },
    {
      "type": "textbox",
      "name": "txtTitle",
      "height": 25,
      "margin": "0,0,0,10"
    },
    {
      "type": "label",
      "text": "Description:",
      "bold": true,
      "margin": "0,0,0,5"
    },
    {
      "type": "textbox",
      "name": "txtDescription",
      "height": 80,
      "multiline": true,
      "margin": "0,0,0,10"
    },
    {
      "type": "label",
      "text": "Steps to Reproduce:",
      "bold": true,
      "margin": "0,0,0,5"
    },
    {
      "type": "textbox",
      "name": "txtSteps",
      "height": 60,
      "multiline": true,
      "margin": "0,0,0,10"
    },
    {
      "type": "stackpanel",
      "orientation": "Horizontal",
      "margin": "0,0,0,5",
      "children": [
        {
          "type": "label",
          "text": "Severity:",
          "bold": true
        },
        {
          "type": "combobox",
          "name": "cmbSeverity",
          "width": 100,
          "items": ["Low", "Medium", "High", "Critical"],
          "selectedIndex": 1
        }
      ]
    },
    {
      "type": "label",
      "text": "Screenshots (Optional):",
      "bold": true,
      "margin": "0,5,0,2"
    },
    {
      "type": "label",
      "text": "• App-only screenshots for security",
      "fontSize": 10,
      "foreground": "Gray",
      "margin": "0,0,0,2"
    },
    {
      "type": "stackpanel",
      "orientation": "Horizontal",
      "margin": "0,0,0,5",
      "children": [
        {
          "type": "button",
          "name": "btnTakeScreenshot",
          "text": "📸 App Screenshot",
          "width": 120,
          "height": 28,
          "tooltip": "Capture application window only (secure)"
        },
        {
          "type": "button",
          "name": "btnAttachFile",
          "text": "📎 Attach File",
          "width": 100,
          "height": 28,
          "margin": "10,0,0,0",
          "tooltip": "Attach existing image file"
        }
      ]
    }
  ],
  "buttons": [
    {
      "text": "Submit Bug Report",
      "action": "submitBug",
      "width": 150,
      "height": 35,
      "style": "primary"
    }
  ]
}
{
  "services": {
    "EC2": {
      "name": "EC2 Instances",
      "icon": "🖥️",
      "command": "ec2 describe-instances",
      "dataPath": "Reservations[].Instances[]",
      "fields": ["Tags[?Key=='Name'].Value|[0]", "InstanceId", "State.Name", "PrivateIpAddress", "InstanceType", "Platform"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": true
    },
    "RDS": {
      "name": "RDS Databases",
      "icon": "🗄️",
      "command": "rds describe-db-instances",
      "dataPath": "DBInstances",
      "fields": ["DBInstanceIdentifier", "Engine", "DBInstanceStatus", "DBInstanceClass", "AllocatedStorage"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": true
    },
    "S3": {
      "name": "S3 Buckets",
      "icon": "🪣",
      "command": "s3api list-buckets",
      "dataPath": "Buckets",
      "fields": ["Name", "CreationDate"],
      "regions": [],
      "enabled": true
    },
    "Lambda": {
      "name": "Lambda Functions",
      "icon": "⚡",
      "command": "lambda list-functions",
      "dataPath": "Functions",
      "fields": ["FunctionName", "Runtime", "State", "MemorySize", "Timeout"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": true
    },
    "ECS": {
      "name": "ECS Services",
      "icon": "📦",
      "command": "ecs list-services",
      "dataPath": "serviceArns",
      "fields": ["serviceArns"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": false
    },
    "EKS": {
      "name": "EKS Clusters",
      "icon": "☸️",
      "command": "eks list-clusters",
      "dataPath": "clusters",
      "fields": ["clusters"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": false
    },
    "CloudFormation": {
      "name": "CloudFormation Stacks",
      "icon": "📋",
      "command": "cloudformation list-stacks",
      "dataPath": "StackSummaries",
      "fields": ["StackName", "StackStatus", "CreationTime"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": false
    },
    "IAM": {
      "name": "IAM Users/Roles",
      "icon": "👤",
      "command": "iam list-users",
      "dataPath": "Users",
      "fields": ["UserName", "CreateDate", "Arn"],
      "regions": [],
      "enabled": false
    },
    "VPC": {
      "name": "VPC Networks",
      "icon": "🌐",
      "command": "ec2 describe-vpcs",
      "dataPath": "Vpcs",
      "fields": ["VpcId", "CidrBlock", "State"],
      "regions": ["us-east-1", "us-west-2", "ca-central-1"],
      "enabled": false
    },
    "Route53": {
      "name": "Route53 Domains",
      "icon": "🌍",
      "command": "route53 list-hosted-zones",
      "dataPath": "HostedZones",
      "fields": ["Name", "Id", "ResourceRecordSetCount"],
      "regions": [],
      "enabled": false
    }
  }
}
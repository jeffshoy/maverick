# AWS Management Studio - Git Ignore Configuration

# Development Rules (Feature branches only)
.amazonq/

# User Settings (may contain sensitive data)
%APPDATA%/AWS-Management-Studio/
settings.json
user-settings.json
search-history.json
favorites.json
service-config.json

# Temporary Files and Logs
*.tmp
*.log
debug-logs.json
debug-logs.html

# Screenshots (may contain sensitive information)
screenshots/
*.png
*.jpg
*.jpeg
*.bmp
*.gif

# Test Results (can be regenerated)
test-results.html
test-results.json
TEST_RESULTS.md

# IDE and System Files
.vscode/
.vs/
*.suo
*.user
Thumbs.db
.DS_Store

# PowerShell Module Cache
*.psm1.cache

# Windows Credential Manager exports
*.cred
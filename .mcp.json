{
  "mcpServers": {
    "logicmonitor": {
      "command": "npx",
      "args": ["logicmonitor-api-mcp", "--stdio"],
      "env": {
        "LM_ACCOUNT": "${LM_ACCOUNT}",
        "LM_BEARER_TOKEN": "${LM_BEARER_TOKEN}"
      }
    },
    "sectigo": {
      "command": "python",
      "args": ["scripts/sectigo/mcp_proxy.py"],
      "env": {
        "SECTIGO_CLIENT_ID": "${SECTIGO_CLIENT_ID}",
        "SECTIGO_CLIENT_SECRET": "${SECTIGO_CLIENT_SECRET}"
      }
    }
  }
}

mgmt-microsoft/changedns-ms_*.log

# LM credentials
.env
*.env

# Claude local settings (contains credentials)
.claude/settings.local.json

# Sectigo — output files contain plaintext service account passwords
scripts/sectigo/MassServerAdd/servers_*.json
# Sectigo — timestamped output CSVs and spreadsheets (run artifacts, not source)
scripts/sectigo/MassServerAdd/sectigo_servers_added_*.csv
scripts/sectigo/MassServerAdd/cert_locations_*.csv
scripts/sectigo/MassServerAdd/audit_split_certs_*.csv
scripts/sectigo/MassServerAdd/agent_nodes_*.csv
scripts/sectigo/MassServerAdd/verify_iis_certs_*.csv
scripts/sectigo/MassServerAdd/servers_*_inactive_*.csv
scripts/sectigo/MassServerAdd/servers_*_inactive_search_*.csv
scripts/sectigo/MassServerAdd/inactive_servers_*.csv
scripts/sectigo/MassServerAdd/servers_*_search_*.csv
scripts/sectigo/MassServerAdd/*.xlsx
# Sectigo — root-level working directory (run artifacts, never committed)
/Sectigo/

# Decommission scripts — client-specific run artifacts (instance manifests, backup
# results, parameter dumps), not source. Keep the .ps1 scripts, exclude everything
# these runs generate.
scripts/aws/decommission/*-decommission-*.csv
scripts/aws/decommission/decommission-backups-*.csv
scripts/aws/decommission/*_prod_params.json
scripts/aws/decommission/*_stg_params.json
scripts/aws/decommission/*_stg_instances.csv
scripts/aws/decommission/*_prod_instances.csv
scripts/aws/decommission/*-instances.csv

# Python
__pycache__/
*.pyc
*.pyo

# IDE — track tasks.json (team launcher) but not personal settings
.vscode/*
!.vscode/tasks.json
.idea/

# Kiro — user-specific config stays local, not in the repo
.kiro/steering/
.kiro/specs/
.kiro/hooks/

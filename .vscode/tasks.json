    {
      "id": "awsAccount",
      "type": "promptString",
      "description": "Account name or nickname — fuzzy match (e.g. PLUS, SharedServices, PALegacyPlus)"
    },
    {
      "id": "awsProfile",
      "type": "promptString",
      "description": "AWS profile name from ~/.aws/config (e.g. PALegacySharedServices)",
      "default": "PALegacySharedServices"
    },
    {
      "id": "awsRegion",
      "type": "pickString",
      "description": "AWS region",
      "options": ["us-east-1", "us-west-2", "ca-central-1"],
      "default": "us-east-1"
    }
